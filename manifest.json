{
  "manifest_version": 3,
  "name": "Refresh Counter Overlay",
  "version": "2.0",
  "description": "リロード回数を画面上のオーバーレイで表示します。",
  "permissions": [
    "webNavigation",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}